{
  "appId": "com.nostrpix.app",
  "appName": "NostrPix",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 60
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#00A859",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
